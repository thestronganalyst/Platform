{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thestronganalyst/platform/schemas/preset.schema.json",
  "title": "Preset (presets/<name>.yaml)",
  "type": "object",
  "required": [
    "name",
    "hosting",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "hosting": {
      "enum": [
        "aws",
        "free"
      ]
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$"
      }
    }
  }
}
