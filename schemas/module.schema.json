{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thestronganalyst/platform/schemas/module.schema.json",
  "title": "Platform module declaration (module.yaml)",
  "type": "object",
  "required": [
    "name",
    "version",
    "layer",
    "status",
    "drift",
    "hosting",
    "platforms",
    "provides",
    "requires"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "layer": {
      "enum": [
        "foundation",
        "capability",
        "domain"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "incubating",
        "stable"
      ],
      "description": "planned = folder exists, no implementation; incubating = used by one app; stable = used unchanged by two apps"
    },
    "drift": {
      "enum": [
        "platform-owned",
        "forked"
      ]
    },
    "hosting": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "aws",
          "free"
        ]
      }
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "api",
          "web",
          "mobile"
        ]
      }
    },
    "provides": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "optional": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/interface"
      }
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "default"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "string",
              "boolean",
              "integer",
              "array",
              "object"
            ]
          },
          "default": {},
          "description": {
            "type": "string"
          },
          "enum": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "source": {
      "type": "string"
    },
    "incubates_in": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "interface": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+@[0-9]+$",
      "description": "domain.name@major, e.g. identity.session@1"
    }
  }
}
