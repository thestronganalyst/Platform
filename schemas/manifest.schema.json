{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thestronganalyst/platform/schemas/manifest.schema.json",
  "title": "App manifest (platform.yaml)",
  "type": "object",
  "required": [
    "app",
    "preset",
    "hosting"
  ],
  "additionalProperties": false,
  "properties": {
    "app": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "preset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "hosting": {
      "enum": [
        "aws",
        "free"
      ]
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remove": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "add": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$"
      },
      "description": "Keys are <module>.<config key>"
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    }
  }
}
